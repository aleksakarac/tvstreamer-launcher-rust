// Arc Blueberry Theme - Dark blue with pink accents
// Optimized: All colors as constants, no runtime computation

export global Theme {
    // Background colors
    out property <color> bg-primary: #111422;
    out property <color> bg-secondary: #1a1e33;
    out property <color> bg-tile: #1e2340;
    out property <color> bg-tile-selected: #2d3555;

    // Foreground colors
    out property <color> fg-primary: #bcc1dc;
    out property <color> fg-secondary: #8a90a8;
    out property <color> fg-dim: #5a6080;

    // Accent colors
    out property <color> accent: #8eb0e6;
    out property <color> accent-pink: #f38cec;
    out property <color> accent-cyan: #69c3ff;

    // Status colors
    out property <color> status-good: #3cec85;
    out property <color> status-warn: #eacd61;
    out property <color> status-critical: #e35535;
    out property <color> status-temp-warn: #ff955c;

    // Dimensions
    out property <length> tile-width: 140px;
    out property <length> tile-height: 130px;
    out property <length> tile-spacing: 20px;
    out property <length> tile-radius: 16px;
    out property <length> border-width: 2px;

    // Font sizes
    out property <length> font-clock: 120px;
    out property <length> font-date: 32px;
    out property <length> font-tile: 16px;
    out property <length> font-stat-value: 24px;
    out property <length> font-stat-label: 12px;
    out property <length> font-icon: 48px;
}
